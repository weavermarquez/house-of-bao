#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "==> Checking the Node.js toolchain"
node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  const supported = (major === 20 && minor >= 19) ||
    (major === 22 && minor >= 12) || major > 22;
  if (!supported) {
    throw new Error(`Node.js ^20.19.0 or >=22.12.0 is required; found ${process.version}`);
  }
'
npm --version

echo "==> Installing orb development tools"
if [[ "$(bd version 2>/dev/null || true)" != *"0.29.0"* ]]; then
  npm install --global --prefix "$HOME/.local" --no-audit --no-fund "@beads/bd@0.29.0"
fi

echo "==> Installing web app dependencies"
time npm ci --prefix "$repo_root/house-of-bao" --no-audit --no-fund

echo "==> Orb setup complete"
